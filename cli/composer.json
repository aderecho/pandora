{
    "name": "narrasoft/fileserver-cli",
    "description": "Official command-line client for the self-hosted FileServer platform (S3-style object storage).",
    "type": "library",
    "license": "MIT",
    "keywords": ["fileserver", "cli", "s3", "object-storage", "storage", "client"],
    "authors": [
        {
            "name": "Narrasoft",
            "email": "anthony.derecho@narrasoft.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/console": "^7.1",
        "guzzlehttp/guzzle": "^7.9",
        "symfony/process": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "FileServerCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FileServerCli\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/fileserver"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
